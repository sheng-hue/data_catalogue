# Example Streamlit secrets file
# Copy this to .streamlit/secrets.toml and fill in your values
# WARNING: Never commit secrets.toml to git!

# OpenAI API Key (if using OpenAI for LLM)
# OPENAI_API_KEY = "sk-..."

# Anthropic API Key (if using Anthropic Claude)
# ANTHROPIC_API_KEY = "sk-ant-..."

# Optional: Default Snowflake connection settings
# These will pre-populate the connection form but users can override them
# [snowflake]
# account = "your-account.snowflakecomputing.com"
# user = "your-email@company.com"
# role = "YOUR_ROLE"
# warehouse = "YOUR_WAREHOUSE"
